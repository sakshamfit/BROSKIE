# Docker Compose / local backend configuration
# Copy this file to `.env`, then replace the placeholder values. `.env` is
# ignored by Git and is never copied into the Docker image.
#
# Generate a value with: openssl rand -hex 32
JWT_SECRET=

# Host port for `docker compose up`.
PLUSONE_PORT=4000

# Comma-separated browser origins allowed to call the API and Socket.IO.
# `*` is convenient for local development only. Set the exact HTTPS web
# origins before any public deployment, for example:
# Production +one web origins (include both while the www alias is live).
# For local-only development, use `*` instead.
CORS_ORIGIN=https://plusoneco.in,https://www.plusoneco.in

# Optional account bootstrap configuration.
# ADMIN_USERNAMES=saksham
# GOLD_TICK_USERNAMES=saksham

# Optional retention for automatic SQLite backups stored in the Docker volume.
BACKUP_KEEP=20

# Optional Supabase Storage. SERVICE_KEY is server-only: never use an anon key
# here and never expose it through EXPO_PUBLIC_* variables.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=tomodachi-uploads

# WebRTC calls work peer-to-peer through the default Google STUN server on
# home/office Wi-Fi. Calls over MOBILE CARRIER networks (Android/iOS web or
# apps) usually need a TURN relay — without one the call stalls on
# "Connecting…". Bake relay credentials into the WEB build with this build-time
# variable (JSON array). Example using a coturn/Cloudflare/Xirsys relay:
#
#   EXPO_PUBLIC_ICE_SERVERS='[{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"},{"urls":"turns:turn.example.com:5349","username":"user","credential":"pass"}]'
#
# (Set it in the web build environment — Vercel/Cloudflare Pages — not .env,
# and redeploy the site so the bundle picks it up.)


# Song search uses the iTunes Search API by default, with Deezer as the automatic
# fallback — both free, no API keys, 30-second previews only. Optional env vars:
#   ITUNES_COUNTRY — storefront for iTunes results (default US, e.g. IN for India)
#   ITUNES_API_BASE / DEEZER_API_BASE — override for tests/self-hosted proxies
# (There is intentionally no full-track playback: that requires a licensing deal.)

# Optional stable web-push keys. If omitted, +one generates and persists them
# in the `plusone_data` Docker volume on first boot.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@plusone.app

# Android App Links (true one-tap https:// deep links) — set on Railway, not in
# .env; see docs/SEO_GEO_PLAYBOOK.md §6.
#   keytool -printcert -jarfile plusone.apk | grep -A1 "SHA256:"
ANDROID_PACKAGE_NAME=ai.arena.tomodachi
ANDROID_CERT_FINGERPRINT=
