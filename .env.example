# Docker Compose / local backend configuration
# Copy this file to `.env`, then replace the placeholder values. `.env` is
# ignored by Git and is never copied into the Docker image.
#
# Generate a value with: openssl rand -hex 32
JWT_SECRET=

# Host port for `docker compose up`.
PLUSONE_PORT=4000

# Comma-separated browser origins allowed to call the API and Socket.IO.
# `*` is convenient for local development only. Set the exact HTTPS web
# origins before any public deployment, for example:
# Production +one web origins (include both while the www alias is live).
# For local-only development, use `*` instead.
CORS_ORIGIN=https://plusoneco.in,https://www.plusoneco.in

# Optional account bootstrap configuration.
# ADMIN_USERNAMES=saksham
# GOLD_TICK_USERNAMES=saksham

# Optional retention for automatic SQLite backups stored in the Docker volume.
BACKUP_KEEP=20

# Optional Supabase Storage. SERVICE_KEY is server-only: never use an anon key
# here and never expose it through EXPO_PUBLIC_* variables.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=tomodachi-uploads

# Optional Jamendo song-search client ID.
JAMENDO_CLIENT_ID=

# Optional stable web-push keys. If omitted, +one generates and persists them
# in the `plusone_data` Docker volume on first boot.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@plusone.app
