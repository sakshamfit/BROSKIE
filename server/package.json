{
  "name": "tomodachi-server",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node src/index.js",
    "build": "cd ../app && npm install && CI=true npx expo export --platform web --output-dir ../server/public",
    "postinstall": "echo 'run npm run build to bundle the web app into ./public'",
    "backup": "node src/backup.js",
    "audit:chats": "node src/chat-audit.js",
    "test:chat-history": "node test-chat-history.js",
    "test:offline-messaging": "node test-offline-messaging.js",
    "test:message-state": "node test-message-state.js",
    "test:push": "node test-push.js",
    "test:phase2": "node test-phase2.js",
    "test:phase3": "node test-phase3.js",
    "test:moderation": "node test-moderation.js",
    "test:ot": "node test-ot.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.5.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^3.3.7",
    "socket.io": "^4.8.1",
    "web-push": "^3.6.7",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.3"
  }
}
