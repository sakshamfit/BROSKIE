# ---- required in production ----
JWT_SECRET=change-me-to-a-long-random-string   # openssl rand -hex 32

# ---- persistent storage (so chats/users/uploads survive redeploys) ----
# Point this at a mounted volume (Railway Volume, Render Disk, etc.) and the
# SQLite database + locally-stored photo uploads both move there instead of
# the container's ephemeral disk. On Railway this is auto-detected via
# RAILWAY_VOLUME_MOUNT_PATH once you attach a Volume — you don't need to set
# this yourself there. See DEPLOY.md → "Never lose data on deploy".
# DATA_DIR=/var/data

# ---- Supabase Storage (persists uploaded images across redeploys) ----
# Set these to stop losing uploads on every deploy.
# SUPABASE_URL=https://ldrdawvivzggzoxyiugf.supabase.co
# SUPABASE_SERVICE_KEY=your-service_role-key    # server-side secret, never commit
# SUPABASE_BUCKET=tomodachi-uploads

# PORT is provided by the host (Railway/Render); defaults to 4000 locally

# ---- Jamendo (song attachments on Status updates) ----
# Creative-Commons music catalogue, free full-track streaming — no OAuth
# needed for search, just a client_id. Get one at https://devportal.jamendo.com/
# JAMENDO_CLIENT_ID=your-client-id
# JAMENDO_CLIENT_SECRET=your-client-secret   # only needed if you add OAuth-gated endpoints later