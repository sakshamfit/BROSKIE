# ---- required in production ----
JWT_SECRET=change-me-to-a-long-random-string   # openssl rand -hex 32

# ---- optional: persist uploaded images (see SUPABASE.md) ----
# Without these, uploads go to server/uploads and are LOST on redeploy.
# SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# SUPABASE_SERVICE_KEY=your-service_role-key    # server-side secret, never commit
# SUPABASE_BUCKET=broskie-uploads

# PORT is provided by the host (Railway/Render); defaults to 4000 locally
