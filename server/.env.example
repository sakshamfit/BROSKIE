# +one backend configuration
# Copy to server/.env for a host-run server. Docker Compose uses the root
# .env.example instead. Never commit either resulting .env file.

# ---- required in production ----
# Generate with: openssl rand -hex 32
JWT_SECRET=

# ---- HTTP / realtime ----
# PORT defaults to 4000 locally (provided by Railway/Render in their runtimes).
# PORT=4000
# Comma-separated browser origins. Production uses the public +one domain;
# include localhost origins too when testing Expo web locally. Keep `*` only
# for local-only development.
CORS_ORIGIN=https://plusoneco.in,https://www.plusoneco.in

# ---- Admin + gold tick bootstrap ----
# Comma-separated usernames granted the backend `admin` role on boot
# (default "saksham"). The server still enforces its owner rule for admin APIs.
# ADMIN_USERNAMES=saksham
# Comma-separated usernames granted the gold verification tick on boot and on
# registration (default "saksham").
# GOLD_TICK_USERNAMES=saksham

# ---- persistent SQLite, uploads, backups and generated VAPID keys ----
# Point this at a mounted volume (Railway Volume, Render Disk, Docker volume).
# SQLite data, local uploads and automatic backups live below this directory.
# DATA_DIR=/var/data
# On Railway, also set RAILWAY_RUN_UID=0 (service Variables). Volumes are
# mounted as root; without it boot crashes with SQLITE_READONLY.
# BACKUP_DIR=/var/data/backups
# BACKUP_KEEP=20

# ---- Supabase Storage (optional; server-side secret only) ----
# Set both values to store uploads in Supabase instead of the mounted disk.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=your-service-role-key
# SUPABASE_BUCKET=tomodachi-uploads

# ---- Browser Push / VAPID (optional) ----
# When omitted, keys are generated once and persisted in DATA_DIR. Set stable
# values when external secret management is preferred.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@example.com

# ---- Jamendo song attachments (optional) ----
# JAMENDO_CLIENT_ID=
