# Keep the build context small and keep ephemeral/secret data out of the image.
node_modules
npm-debug.*
*.log

# Runtime data — never bake the database or uploads into the image
data/
*.db
*.db-wal
*.db-shm
uploads/*
!uploads/.gitkeep

# Built web bundle (generated by `npm run build`); not needed server-side
public/

# Secrets — never bake credentials into an image
.env
.env.*
!.env.example

# Dev-only test scripts (run with `npm run test:*` outside the container)
test-*.js

# VCS / editor noise
.git
.gitignore
Dockerfile
.dockerignore
