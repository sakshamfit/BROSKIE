# dependencies
node_modules/
.npm/

# runtime data (SQLite db + WAL/SHM) — never commit
server/data/
*.db
*.db-wal
*.db-shm

# user uploads
server/uploads/*
!server/uploads/.gitkeep

# expo / metro / build output
.expo/
.expo-shared/
dist/
web-build/
android/
ios/
*.jsbundle

# env & secrets
.env
.env.*
!.env.example
.netrc
.git-credentials

# firebase: app/google-services.json holds only public identifiers and IS
# committed (remote EAS builds only upload git-tracked files). The
# service-account private key is a true secret — never commit one.
*-firebase-adminsdk-*.json

# logs
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# os / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# expo template leftovers
app/.claude/
app/AGENTS.md
app/CLAUDE.md

# vercel
.vercel

# built web bundle (generated by npm run build)
server/public/

# python
__pycache__/
