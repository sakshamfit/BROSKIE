# Point the app at a custom backend for local development.
# Production builds have a built-in HTTPS proxy, so this can stay unset.
#
# Web (same machine)      -> leave unset, the app auto-detects http://<host>:4000
# Physical device / Expo  -> set this to your computer's LAN IP (NOT localhost,
#                            the phone cannot reach its own localhost)
#
# Find your IP:
#   macOS : ipconfig getifaddr en0
#   Linux : hostname -I | awk '{print $1}'
#   Windows: ipconfig
#
# EXPO_PUBLIC_API_URL=http://192.168.1.42:4000
