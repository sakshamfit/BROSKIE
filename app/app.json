{
  "expo": {
    "name": "\u53cb\u9054",
    "slug": "tomodachi",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.arena.tomodachi",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "\u53cb\u9054 uses the microphone to record voice messages.",
        "NSPhotoLibraryUsageDescription": "\u53cb\u9054 needs photo access so you can share images in chats.",
        "UIRequiresFullScreen": false
      }
    },
    "android": {
      "package": "ai.arena.tomodachi",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#fdf8f8"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "\u53cb\u9054",
      "shortName": "\u53cb\u9054",
      "description": "\u53cb\u9054 \u2014 a realtime ink-and-paper messenger.",
      "lang": "en",
      "scope": "/",
      "startUrl": "/",
      "display": "standalone",
      "orientation": "any",
      "themeColor": "#fdf8f8",
      "backgroundColor": "#fdf8f8",
      "barStyle": "default"
    },
    "plugins": [
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow \u53cb\u9054 to access your photos to share them in chats."
        }
      ],
      "expo-font",
      "expo-screen-orientation",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fdf8f8",
          "image": "./assets/splash-icon.png",
          "imageWidth": 230,
          "resizeMode": "contain"
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/cfaadedd-ce58-4cec-b88f-261178485cda",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "extra": {
      "eas": {
        "projectId": "cfaadedd-ce58-4cec-b88f-261178485cda"
      }
    }
  }
}
