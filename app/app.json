{
  "expo": {
    "name": "+one",
    "slug": "saksham",
    "version": "1.4.0",
    "platforms": ["ios", "android", "web"],
    "orientation": "default",
    "scheme": "plusone",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.arena.tomodachi",
      "buildNumber": "5",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "+one uses the microphone to record voice messages.",
        "NSPhotoLibraryUsageDescription": "+one needs photo access so you can share images in chats.",
        "UIRequiresFullScreen": false,
        "NSCameraUsageDescription": "+one uses the camera for video calls."
      }
    },
    "android": {
      "package": "ai.arena.tomodachi",
      "googleServicesFile": "./google-services.json",
      "versionCode": 6,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#000000"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "POST_NOTIFICATIONS",
        "CAMERA",
        "MODIFY_AUDIO_SETTINGS"
      ],
      "minSdkVersion": 24
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "name": "+one",
      "shortName": "+one",
      "description": "+one — a realtime ink-and-paper messenger.",
      "lang": "en",
      "scope": "/",
      "startUrl": "/",
      "display": "standalone",
      "orientation": "any",
      "themeColor": "#fdf8f8",
      "backgroundColor": "#fdf8f8",
      "barStyle": "default"
    },
    "plugins": [
      "./plugins/withAuthNetworkSecurity",
      "expo-audio",
      "expo-notifications",
      "@config-plugins/react-native-webrtc",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "+one uses your location once a day to include local weather in the AI greeting."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow +one to access your photos to share them in chats."
        }
      ],
      "expo-font",
      "expo-screen-orientation",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fdf8f8",
          "image": "./assets/splash-icon.png",
          "imageWidth": 230,
          "resizeMode": "contain"
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/cfaadedd-ce58-4cec-b88f-261178485cda",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 5000
    },
    "extra": {
      "eas": {
        "projectId": "cfaadedd-ce58-4cec-b88f-261178485cda"
      }
    }
  }
}
