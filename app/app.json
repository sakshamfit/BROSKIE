{
  "expo": {
    "name": "友達",
    "slug": "tomodachi",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.arena.tomodachi",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "友達 uses the microphone to record voice messages.",
        "NSPhotoLibraryUsageDescription": "友達 needs photo access so you can share images in chats.",
        "UIRequiresFullScreen": false
      }
    },
    "android": {
      "package": "ai.arena.tomodachi",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#075E54"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow 友達 to access your photos to share them in chats."
        }
      ],
      "expo-font",
      "expo-screen-orientation",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#075E54",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
