{
  // Cloudflare Workers (static-assets-only) config for the 友達 WEB FRONTEND.
  //
  // IMPORTANT: this deploys the frontend ONLY. The backend (Node + Socket.IO,
  // needed for realtime chat) cannot run here — Workers spin up per-request
  // and can't hold a persistent WebSocket connection the way this app's
  // server does. Deploy server/ to Railway or Render (see DEPLOY.md) and
  // point EXPO_PUBLIC_API_URL (below) at that backend's URL.
  //
  // This is the same "two hosts" pattern already documented for Vercel in
  // DEPLOY.md — Cloudflare Workers is just another place to put the static
  // half. If you don't need Cloudflare specifically, the single-host
  // Railway/Render setup in DEPLOY.md is simpler (one service, no CORS).
  "name": "tomodachi",
  "compatibility_date": "2026-08-16",
  "assets": {
    // `npm run build` (root package.json) runs `expo export --platform web`
    // and writes the static site here.
    "directory": "./app/dist",
    // Client-side routed SPA: unmatched paths fall back to index.html
    // instead of a Cloudflare 404, so deep links (e.g. refreshing on a
    // sub-page) work.
    "not_found_handling": "single-page-application"
  }
}
