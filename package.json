{
  "name": "tomodachi",
  "version": "1.0.0",
  "private": true,
  "description": "+one \u2014 realtime ink-and-paper messenger. Root manifest so hosts (Railway/Render/Nixpacks) detect a Node project and delegate to server/.",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "build": "cd server && npm install && npm run build",
    "start": "cd server && npm start",
    "dev:server": "cd server && npm run dev",
    "dev:app": "cd app && npx expo start",
    "build:cloudflare": "cd app && npm ci && EXPO_PUBLIC_API_URL=https://broskie-h.up.railway.app CI=true npx expo export --platform web --output-dir dist",
    "deploy:cloudflare": "npx wrangler deploy",
    "backup": "cd server && npm run backup",
    "ci": "bash scripts/ci.sh",
    "audit:chats": "cd server && npm run audit:chats --",
    "test:chat-history": "cd server && npm run test:chat-history",
    "test:offline-messaging": "cd server && npm run test:offline-messaging",
    "test:message-state": "cd server && npm run test:message-state",
    "test:push": "cd server && npm run test:push",
    "test:phase2": "cd server && npm run test:phase2",
    "test:phase3": "cd server && npm run test:phase3",
    "test:moderation": "cd server && npm run test:moderation"
  },
  "workspaces": [],
  "license": "MIT"
}
